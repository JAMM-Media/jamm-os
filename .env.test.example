# Copy this file to .env.test and fill in real values before running tests locally.
# docker-compose up -d db then set DATABASE_URL to match.

# PostgreSQL connection string for the test database
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/accounting_dev

# Enable the nurture tick during tests (must be true for nurture test suite)
NURTURE_SENDS_ENABLED=true

# Stripe server-side secret key (only needed if Stripe webhook tests run locally)
STRIPE_SECRET_KEY=sk_test_placeholder_not_real

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_not_real
